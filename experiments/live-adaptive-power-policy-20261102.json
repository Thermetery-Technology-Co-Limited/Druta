  "contract": {
    "get": "2080A801 type4 attr9 support; attr10 enabled iff complete reason DWORD zero. Invalid rows are unavailable.",
    "set": "2080E802 type4 attr10 value0 sets shared bit1; value1 clears only bit1. Other reasons may keep policy disabled. Not counted or per-client ownership.",
    "verification": "Exact routing/opaque preservation, Boolean support/state, exact SET acknowledgement and stable before/after aggregate. No SET retry. Unchanged/masked aggregate is explicitly unverified request effect.",
    "admission": "Native Blackwell 0x1B0, source-qualified implementations2/3/5/6/7 and current per-role support; no board or driver allowlist.",
    "lifecycle": "No owned-reference cleanup, numeric threshold restoration, profile or driver-restart replay."
  },
