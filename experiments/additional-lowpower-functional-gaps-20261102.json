  "ltr": {
    "native_contract": {
      "set_20801818": "8 bytes: u16 snoop value +0, u8 snoop scale +2, u16 no-snoop value +4, u8 no-snoop scale +6. Setter masks value 10 bits, scale 3 bits; no range validation in selected routine.",
      "request_8a254": "snoop value bits10:1; snoop scale13:11; forced bit14=1; no-snoop value24:15; no-snoop scale27:25; forced bit28=1; bit0 trigger=1 and polled. Remaining retained bits follow read/modify/write mask 0xf0004001, combined with forced 0x10004001.",
      "get_20801817": "reads 8a24c and projects snoop value9:0 scale12:10; no-snoop value23:14 scale26:24. Public output excludes status bits13 and27 and trigger-source bits. Error is suppressed by outer handler.",
      "relation": "Shifting request fields and forced bits right by one matches the status field layout exactly; official NVIDIA GA102 published LAST_MSG_SENT uses the same status layout including requirement bits13 and27. This homologous mapping does not prove current register names, each SET reflected as latest message, requirement meaning, or ability to deassert.",
      "units": "Pinned NVIDIA public API header gives no units or permitted scale semantics. Prior primary Linux source L1.2 threshold encoding uses scales0..5 for 1,32,1024,32768,1048576,33554432 ns; it is analogous PCIe encoding, not proof of this NVIDIA API. Scales6..7 are not rejected by selected setter; semantic validity is unestablished.",
      "ownership": "No separate owned handle or release operation exists in public SET packet; setter issues a message trigger and returns after bit clears or timeout. Duration and replacement semantics beyond that event are not established."
    },
    "zero_request_example": {
      "original_request_register": 0,
      "all_zero_fields_after_native_packing": "0x10004001",
      "if_only_trigger_bit_clears": "0x10004000",
      "conclusion": "Even with all four public values zero, the packed request differs from the captured all-zero raw baseline. Public GET omits these additional bits, so equality of its four fields cannot establish equality of the request."
    },
    "primary_semantics": {
      "url": "https://cdrdv2-public.intel.com/333016/333016%20-%20I210_Datasheet_v_3_7.pdf",
      "section": "8.25.9, printed page541",
      "scope": "Independent PCIe LTR example on Intel I210, not a binding of NVIDIA proprietary registers.",
      "paraphrase": "With a requirement asserted, zero latency requests best service. Clearing the requirement denotes no latency requirement. Device-specific scale choices must not be generalized to this NVIDIA interface."
    },
    "next_requirement": "Bind the current NVIDIA request/status semantics and distinguish an actual reflected SET from unrelated last-message updates. No claim that unknown reset/replay behavior is a prerequisite to all other functionality.",
