        "scope": "Offline selected-controller DIFR reason0 inhibit review; no GPU calls, product edits, physical-state claim, saved requests or persistence.",
        "product_files_sha256": {
          "src/druta/difr_live_control.py": "07af8591e4b847b1ed9460ef45923669a27131ebfc3b63d5e6937a73ecf49b56",
