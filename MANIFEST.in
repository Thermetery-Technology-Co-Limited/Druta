# The sdist can rebuild both the wheel and the distributable Windows bundle.
include druta.py src/run_druta.py Druta.spec build.ps1 requirements.txt pyproject.toml setup.py MANIFEST.in
include AGENTS.md COPYING THIRD-PARTY-NOTICES.md README.md MANUAL.md
include TECHNICALDOCUMENTATION.md DEBUG-SUMMARY-RTX5080.md
include VOLTAGE-RAILS-TITAN.md VOLTAGE-RAILS-47212.md DRIVER-COMPATIBILITY.md
include RELEASE-NOTES-1.3.0.md
include MAXWELL-PASCAL-VALIDATION.md
include BLACKWELL-VALIDATION.md
include .github/PULL_REQUEST_TEMPLATE/i2c_profile.md
recursive-include src/druta *.py
recursive-include tests *.py
include i2c/*.toml i2c/*.md

